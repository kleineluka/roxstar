<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Pinboard', extraStyles: `
    <style>
        .sp-pb-msg { font-size: 12px; color: #555575; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .sp-modal textarea.sp-input { border-radius: 12px; padding: 10px 14px; resize: vertical; min-height: 80px; width: 100%; font-family: inherit; }
        .sp-filter-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
        .sp-filter-tab { padding: 5px 14px; border-radius: 999px; font-size: 12px; font-weight: 800; border: 1.5px solid #d0d0e0; background: #fff; color: #555575; cursor: pointer; transition: background 0.12s, color 0.12s; }
        .sp-filter-tab.active { background: var(--btn-purple); color: #fff; border-color: var(--btn-purple); }
    </style>
` }) %></head>
<body><script>if(localStorage.getItem('sp-dark')==='1')document.body.classList.add('dark');</script>
<div class="sp-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<div class="sp-layout">
    <%- include('../partials/sidebar', { page: 'pinboard' }) %>
    <div class="sp-main">
        <%- include('../partials/header', {
            title: 'Pinboard',
            subtitle: 'View, moderate, and manage player message boards',
            actions: '<button class="sp-btn sp-btn-success sp-btn-sm" onclick="openAddModal()" style="margin-left:auto;">+ Add Message</button>'
        }) %>
        <main class="sp-content">
            <div class="sp-search-bar" style="flex-wrap:wrap;gap:10px;">
                <div class="sp-filter-tabs" id="filterTabs">
                    <button class="sp-filter-tab active" data-status="all" onclick="setStatus('all')">All</button>
                    <button class="sp-filter-tab" data-status="pending" onclick="setStatus('pending')">Pending</button>
                    <button class="sp-filter-tab" data-status="accepted" onclick="setStatus('accepted')">Accepted</button>
                    <button class="sp-filter-tab" data-status="reported" onclick="setStatus('reported')">Reported</button>
                    <button class="sp-filter-tab" data-status="deleted" onclick="setStatus('deleted')">Deleted</button>
                </div>
                <div style="display:flex;gap:8px;flex:1;min-width:200px;">
                    <input class="sp-input" type="text" id="searchInput" placeholder="Search sender or receiver username">
                    <button class="sp-btn sp-btn-primary sp-btn-sm" onclick="doSearch()">Search</button>
                    <button class="sp-btn sp-btn-ghost sp-btn-sm" onclick="clearSearch()">Clear</button>
                </div>
            </div>
            <div class="sp-card">
                <div class="sp-table-wrap">
                    <table class="sp-table">
                        <thead>
                            <tr><th>ID</th><th>Sender</th><th>Receiver</th><th>Message</th><th>Status</th><th>Reported By</th><th>Date</th><th></th></tr>
                        </thead>
                        <tbody id="pbTable">
                            <tr><td colspan="8" class="sp-table-empty">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="sp-pagination">
                    <span class="sp-pagination-info" id="pageInfo"></span>
                    <div style="display:flex;gap:8px;">
                        <button id="prevBtn" class="sp-btn sp-btn-ghost sp-btn-sm" onclick="changePage(-1)">&#8249; Prev</button>
                        <button id="nextBtn" class="sp-btn sp-btn-ghost sp-btn-sm" onclick="changePage(1)">Next &#8250;</button>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<div class="sp-modal-overlay" id="editModal">
    <div class="sp-modal">
        <div class="sp-modal-header">
            <h2 class="sp-modal-title">Edit Message</h2>
            <button class="sp-modal-close" onclick="closeEdit()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <p style="margin:0 0 10px;font-size:12px;color:#9090b0;font-weight:600;">Message ID: <span id="editMsgId" style="color:#1e1b2e;"></span></p>
            <textarea class="sp-input" id="editMsgText" rows="4" placeholder="Message text..."></textarea>
            <p id="editError" style="margin:8px 0 0;font-size:12px;color:#b91c1c;display:none;"></p>
        </div>
        <div class="sp-modal-actions">
            <button class="sp-btn sp-btn-primary sp-btn-sm" onclick="saveEdit()">Save</button>
            <button class="sp-btn sp-btn-ghost sp-btn-sm" onclick="closeEdit()">Cancel</button>
        </div>
    </div>
</div>

<div class="sp-modal-overlay" id="addModal">
    <div class="sp-modal">
        <div class="sp-modal-header">
            <h2 class="sp-modal-title">Add Pinboard Message</h2>
            <button class="sp-modal-close" onclick="closeAdd()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                <div>
                    <label style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#9090b0;display:block;margin-bottom:5px;">Sender User ID</label>
                    <input class="sp-input" type="number" id="addSenderId" placeholder="e.g. 1">
                </div>
                <div>
                    <label style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#9090b0;display:block;margin-bottom:5px;">Receiver User ID</label>
                    <input class="sp-input" type="number" id="addReceiverId" placeholder="e.g. 2">
                </div>
            </div>
            <textarea class="sp-input" id="addMsgText" rows="4" placeholder="Message text..."></textarea>
            <p id="addError" style="margin:8px 0 0;font-size:12px;color:#b91c1c;display:none;"></p>
        </div>
        <div class="sp-modal-actions">
            <button class="sp-btn sp-btn-success sp-btn-sm" onclick="saveAdd()">Post</button>
            <button class="sp-btn sp-btn-ghost sp-btn-sm" onclick="closeAdd()">Cancel</button>
        </div>
    </div>
</div>

<div class="sp-modal-overlay" id="confirmModal">
    <div class="sp-modal">
        <div class="sp-modal-header">
            <h2 class="sp-modal-title">Delete Message</h2>
            <button class="sp-modal-close" onclick="closeConfirm()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <p style="margin:0;font-size:14px;color:#555575;font-weight:600;">Mark message ID <strong id="confirmMsgId"></strong> as deleted?</p>
        </div>
        <div class="sp-modal-actions">
            <button class="sp-btn sp-btn-danger sp-btn-sm" onclick="confirmDelete()">Delete</button>
            <button class="sp-btn sp-btn-ghost sp-btn-sm" onclick="closeConfirm()">Cancel</button>
        </div>
    </div>
</div>

<script>
    <%- include('../partials/scripts', { section: 'moderation' }) %>

    let currentPage = 1, totalPages = 1, currentStatus = 'all', currentSearch = '';
    let editingId = null, pendingDeleteId = null;

    const STATUS_COLORS = { pending: 'amber', accepted: 'green', reported: 'red', deleted: 'slate' };

    function fmtDate(unix) { return unix ? new Date(unix * 1000).toLocaleString() : ''; }

    function statusBadge(s) {
        const c = STATUS_COLORS[s] || 'slate';
        return `<span class="sp-badge sp-badge-${c}">${s || '?'}</span>`;
    }

    function esc(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    async function loadPinboard() {
        const tbody = document.getElementById('pbTable');
        tbody.innerHTML = '<tr><td colspan="8" class="sp-table-empty">Loading...</td></tr>';
        const params = new URLSearchParams({ page: currentPage, limit: 25 });
        if (currentStatus && currentStatus !== 'all') params.set('status', currentStatus);
        if (currentSearch) params.set('search', currentSearch);
        try {
            const r = await fetch('/staff/api/social/pinboard?' + params);
            if (!r.ok) return;
            const d = await r.json();
            totalPages = Math.max(1, Math.ceil(d.total / d.limit));
            document.getElementById('pageInfo').textContent = `${d.total.toLocaleString()} messages \u2014 page ${currentPage} of ${totalPages}`;
            document.getElementById('prevBtn').disabled = currentPage <= 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;
            if (!d.messages.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="sp-table-empty">No messages found.</td></tr>';
                return;
            }
            tbody.innerHTML = d.messages.map(m => {
                const senderLabel = m.sender_name ? `<strong>${esc(m.sender_name)}</strong> <span style="color:#aaa;font-size:10px;">#${m.sender}</span>` : `<span style="color:#aaa">#${m.sender}</span>`;
                const receiverLabel = m.receiver_name ? `<strong>${esc(m.receiver_name)}</strong> <span style="color:#aaa;font-size:10px;">#${m.receiver}</span>` : `<span style="color:#aaa">#${m.receiver}</span>`;
                const reportedBy = m.reported ? `<span style="color:#b91c1c;font-weight:700;">#${m.reported}</span>` : `<span style="color:#ccc">&mdash;</span>`;
                const canApprove = m.status === 'pending' || m.status === 'reported';
                const canDelete = m.status !== 'deleted';
                const msgEscaped = esc(m.message || '').replace(/'/g, '&#39;');
                return `<tr>
                    <td style="color:#aaa;font-size:11px;">${m.id}</td>
                    <td style="font-size:12px;">${senderLabel}</td>
                    <td style="font-size:12px;">${receiverLabel}</td>
                    <td><div class="sp-pb-msg" title="${msgEscaped}">${esc(m.message || '')}</div></td>
                    <td>${statusBadge(m.status)}</td>
                    <td style="font-size:12px;">${reportedBy}</td>
                    <td style="font-size:11px;color:#aaa;">${fmtDate(m.date)}</td>
                    <td>
                        <div style="display:flex;gap:5px;flex-wrap:wrap;">
                            <button class="sp-btn sp-btn-ghost sp-btn-sm" onclick="openEdit(${m.id}, '${msgEscaped}')">Edit</button>
                            ${canApprove ? `<button class="sp-btn sp-btn-success sp-btn-sm" onclick="approveMsg(${m.id})">Approve</button>` : ''}
                            ${canDelete ? `<button class="sp-btn sp-btn-danger sp-btn-sm" onclick="promptDelete(${m.id})">Delete</button>` : ''}
                        </div>
                    </td>
                </tr>`;
            }).join('');
        } catch {}
    }

    function setStatus(s) {
        currentStatus = s; currentPage = 1;
        document.querySelectorAll('.sp-filter-tab').forEach(b => b.classList.toggle('active', b.dataset.status === s));
        loadPinboard();
    }

    function doSearch() { currentSearch = document.getElementById('searchInput').value.trim(); currentPage = 1; loadPinboard(); }
    function clearSearch() { document.getElementById('searchInput').value = ''; currentSearch = ''; currentPage = 1; loadPinboard(); }
    function changePage(dir) { const n = currentPage + dir; if (n < 1 || n > totalPages) return; currentPage = n; loadPinboard(); }

    function openEdit(id, msg) {
        editingId = id;
        document.getElementById('editMsgId').textContent = id;
        document.getElementById('editMsgText').value = msg.replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
        document.getElementById('editError').style.display = 'none';
        document.getElementById('editModal').classList.add('open');
    }

    function closeEdit() { editingId = null; document.getElementById('editModal').classList.remove('open'); }

    async function saveEdit() {
        const msg = document.getElementById('editMsgText').value;
        if (!msg.trim()) {
            document.getElementById('editError').textContent = 'Message cannot be empty.';
            document.getElementById('editError').style.display = 'block';
            return;
        }
        try {
            const r = await fetch(`/staff/api/social/pinboard/${editingId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg }),
            });
            if (r.ok) { closeEdit(); loadPinboard(); }
            else {
                const d = await r.json();
                document.getElementById('editError').textContent = d.error || 'Failed to save.';
                document.getElementById('editError').style.display = 'block';
            }
        } catch {}
    }

    function openAddModal() {
        document.getElementById('addSenderId').value = '';
        document.getElementById('addReceiverId').value = '';
        document.getElementById('addMsgText').value = '';
        document.getElementById('addError').style.display = 'none';
        document.getElementById('addModal').classList.add('open');
    }

    function closeAdd() { document.getElementById('addModal').classList.remove('open'); }

    async function saveAdd() {
        const sid = document.getElementById('addSenderId').value.trim();
        const rid = document.getElementById('addReceiverId').value.trim();
        const msg = document.getElementById('addMsgText').value;
        if (!sid || !rid || !msg.trim()) {
            document.getElementById('addError').textContent = 'All fields are required.';
            document.getElementById('addError').style.display = 'block';
            return;
        }
        try {
            const r = await fetch('/staff/api/social/pinboard', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sender_id: parseInt(sid), receiver_id: parseInt(rid), message: msg }),
            });
            if (r.ok) { closeAdd(); loadPinboard(); }
            else {
                const d = await r.json();
                document.getElementById('addError').textContent = d.error || 'Failed to post.';
                document.getElementById('addError').style.display = 'block';
            }
        } catch {}
    }

    async function approveMsg(id) {
        try {
            const r = await fetch(`/staff/api/social/pinboard/${id}/approve`, { method: 'POST' });
            if (r.ok) loadPinboard();
        } catch {}
    }

    function promptDelete(id) {
        pendingDeleteId = id;
        document.getElementById('confirmMsgId').textContent = id;
        document.getElementById('confirmModal').classList.add('open');
    }

    function closeConfirm() { pendingDeleteId = null; document.getElementById('confirmModal').classList.remove('open'); }

    async function confirmDelete() {
        if (!pendingDeleteId) return;
        const id = pendingDeleteId;
        closeConfirm();
        try {
            const r = await fetch(`/staff/api/social/pinboard/${id}`, { method: 'DELETE' });
            if (r.ok) loadPinboard();
        } catch {}
    }

    document.getElementById('searchInput').addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });

    loadPinboard();
</script>
</body>
</html>
