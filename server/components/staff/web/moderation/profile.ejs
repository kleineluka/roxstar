    // Render friends and messages tab
    function renderSocial() {
        const msgs = profileData.messages ?? [];
        document.getElementById('tab-social').innerHTML = `
            <div class="pr-card" style="margin-bottom:16px">
                <div class="pr-card-header">Friend Stats</div>
                <div class="pr-card-body">
                    <div style="display:flex;gap:28px;">
                        <div class="pr-stat"><div class="pr-stat-val">${profileData.friends.total}</div><div class="pr-stat-lbl">Friends</div></div>
                    </div>
                </div>
            </div>
            <div class="pr-card">
                <div class="pr-card-header">Recent Pinboard Messages Received <span class="pr-count-badge">${msgs.length}</span></div>
                ${msgs.length ? msgs.map(m => `
                    <div class="pr-msg-row">
                        <div class="pr-msg-meta">From <strong>${esc(m.sender_name || m.sender)}</strong> &rarr; <strong>${esc(m.receiver_name || m.receiver)}</strong> &middot; ${fmtDate(m.date)} &middot; <span class="sp-badge sp-badge-${m.status === 'accepted' ? 'green' : m.status === 'deleted' ? 'red' : 'amber'}">${esc(m.status)}</span></div>
                        <div class="pr-msg-text">${esc(m.message)}</div>
                    </div>
                `).join('') : `<div class="pr-empty">No messages.</div>`}
