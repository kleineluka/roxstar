<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Logs' }) %></head>
<body><script>if(localStorage.getItem('sp-dark')==='1')document.body.classList.add('dark');</script>
<div class="sp-sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<div class="sp-layout">
    <%- include('../partials/sidebar', { page: 'logs' }) %>
    <div class="sp-main">
        <%- include('../partials/header', { title: 'Staff Logs', subtitle: 'Audit trail of all staff actions' }) %>
        <main class="sp-content">
            <div class="sp-search-bar">
                <input class="sp-input" type="text" id="adminFilter" placeholder="Filter by admin username">
                <button class="sp-btn sp-btn-primary sp-btn-sm" onclick="doFilter()">Filter</button>
                <button class="sp-btn sp-btn-ghost sp-btn-sm" onclick="clearFilter()">Clear</button>
            </div>
            <div class="sp-card">
                <div class="sp-table-wrap">
                    <table class="sp-table">
                        <thead>
                            <tr><th>ID</th><th>Admin</th><th>Event</th><th>Description</th><th>Severity</th><th>Date</th></tr>
                        </thead>
                        <tbody id="logsTable">
                            <tr><td colspan="6" class="sp-table-empty">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="sp-pagination">
                    <span class="sp-pagination-info" id="pageInfo"></span>
                    <div style="display:flex;gap:8px;">
                        <button id="prevBtn" class="sp-btn sp-btn-ghost sp-btn-sm" onclick="changePage(-1)">&#8249; Prev</button>
                        <button id="nextBtn" class="sp-btn sp-btn-ghost sp-btn-sm" onclick="changePage(1)">Next &#8250;</button>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
<script>
    <%- include('../partials/scripts', { section: 'moderation' }) %>

    let currentPage = 1, totalPages = 1, currentAdmin = '';

    const ACTION_MAP = {
        ban:          'red',
        unban:        'green',
        set_staff:    'purple',
        set_rocks:    'amber',
        edit_config:  'slate',
        staff_login:  'green',
        staff_logout: 'slate',
    };

    function fmtDate(unix) { return unix ? new Date(unix * 1000).toLocaleString() : ''; }

    function severityBadge(severity) {
        const severityMap = {
            0: { text: 'CASUAL', color: 'green' },
            1: { text: 'MODERATE', color: 'blue' },
            2: { text: 'SEVERE', color: 'red' }
        };
        const s = severityMap[severity] || { text: 'UNKNOWN', color: 'slate' };
        return `<span class="sp-badge sp-badge-${s.color}">${s.text}</span>`;
    }

    function actionBadge(action) {
        const c = ACTION_MAP[action] || 'slate';
        return `<span class="sp-badge sp-badge-${c}">${action || '?'}</span>`;
    }

    async function loadLogs() {
        const tbody = document.getElementById('logsTable');
        tbody.innerHTML = '<tr><td colspan="6" class="sp-table-empty">Loading...</td></tr>';
        const params = new URLSearchParams({ page: currentPage, limit: 25 });
        if (currentAdmin) params.set('admin', currentAdmin);
        try {
            const r = await fetch('/staff/api/logs?' + params);
            if (!r.ok) return;
            const d = await r.json();
            totalPages = Math.max(1, Math.ceil(d.total / d.limit));
            document.getElementById('pageInfo').textContent = `${d.total.toLocaleString()} entries \u2014 page ${currentPage} of ${totalPages}`;
            document.getElementById('prevBtn').disabled = currentPage <= 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;
            if (!d.logs.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="sp-table-empty">No logs found.</td></tr>';
                return;
            }
            tbody.innerHTML = d.logs.map(log =>
                `<tr>
                    <td style="color:#aaa;font-size:11px">${log.id}</td>
                    <td style="font-weight:800;color:var(--btn-purple)">${log.admin}</td>
                    <td>${actionBadge(log.event_name)}</td>
                    <td style="font-size:12px;color:#777">${log.event_description}</td>
                    <td>${severityBadge(log.severity)}</td>
                    <td style="font-size:11px;color:#aaa">${fmtDate(log.date)}</td>
                </tr>`
            ).join('');
        } catch {}
    }

    function doFilter() { currentAdmin = document.getElementById('adminFilter').value.trim(); currentPage = 1; loadLogs(); }
    function clearFilter() { document.getElementById('adminFilter').value = ''; currentAdmin = ''; currentPage = 1; loadLogs(); }
    function changePage(dir) { const n = currentPage + dir; if (n < 1 || n > totalPages) return; currentPage = n; loadLogs(); }
    document.getElementById('adminFilter').addEventListener('keydown', e => { if (e.key === 'Enter') doFilter(); });

    loadLogs();
</script>
</body>
</html>
